// ==========================================
// MÓDULO 09: VERIFICADOR CONSULAR LMD (v6.0 - DICIREG + FECHAS LIMPIAS)
// ==========================================

// --- CONSTANTES DEL MÓDULO ---
const SHEET_VERIFICACION       = "VERIFICACION_CONSULAR";
const API_LOGIN_URL            = "https://cgelahabana.es/api/login";
const API_EXPEDIENTES_BASE_URL = "https://cgelahabana.es/api/expedientes/";
const SUFIJO_LMD_GET           = "-LMD";       // Para el GET /api/expedientes/{id}
const SUFIJO_LMD_LOGIN         = "-LMD ";      // Para el POST /api/login (con espacio final requerido)
const CONSULADO_OBJETIVO       = "LA HABANA";  // Consulado a filtrar (Col C)
const ESTADO_A_VERIFICAR       = "PENDIENTE RESOLUCION"; // Exacto, sin tilde (Col F)

// Índices de columnas en la hoja EXPEDIENTES LMD (base 0)
const SRC_COL_NOMBRE        = 0; // Columna A
const SRC_COL_APELLIDOS     = 1; // Columna B
const SRC_COL_CONSULADO     = 2; // Columna C
const SRC_COL_CORREO        = 3; // Columna D
const SRC_COL_EXPEDIENTE    = 4; // Columna E
const SRC_COL_ESTADO        = 5; // Columna F
const SRC_COL_IDENTIFICADOR = 8; // Columna I

// Índices de columnas en VERIFICACION_CONSULAR (base 0)
const VCOL_NOMBRE            = 0;
const VCOL_APELLIDOS         = 1;
const VCOL_EXPEDIENTE        = 2;
const VCOL_IDENTIFICADOR     = 3;
const VCOL_ESTADO_CONSULADO  = 4;
const VCOL_NOMBRE_SISTEMA    = 5;
const VCOL_PROGENITOR        = 6;
const VCOL_FECHA_PORTAL      = 7;
const VCOL_FECHA_RESOLUCION  = 8;
const VCOL_FECHA_INSCRIPCION = 9;
const VCOL_DATOS_REGISTRALES = 10;
const VCOL_RESULTADO         = 11;
const VCOL_ULTIMA_VERIF      = 12;

// Cabeceras de la hoja de resultados
const HEADERS_VERIFICACION = [
  'Nombre', 'Apellidos', 'Nº Expediente', 'Identificador',
  'Estado Consulado', 'Nombre en Sistema', 'Progenitor',
  'Fecha Act. Portal', 'Fecha Resolución', 'Fecha Inscripción',
  'Datos Registrales', 'Resultado', 'Última Verificación'
];


